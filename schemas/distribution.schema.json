{
  "$id": "https://plugins.actionlint.kjanat.dev/schemas/distribution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable plugin distribution source",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "sha256",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "type": {
          "const": "release-asset"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "reference",
        "type"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^oci://[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::(?:0{0,4}[1-9]|0{0,3}[1-9][0-9]|0{0,2}[1-9][0-9]{2}|0?[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "oci"
        }
      },
      "additionalProperties": false
    }
  ]
}
