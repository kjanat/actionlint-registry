{
  "$id": "https://plugins.actionlint.kjanat.dev/schemas/submission.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "actionlint plugin submission",
  "type": "object",
  "required": [
    "kind",
    "provider",
    "repository",
    "schema_version",
    "tag"
  ],
  "properties": {
    "artifact": {
      "$ref": "distribution.schema.json"
    },
    "asset": {
      "type": "string",
      "maxLength": 128,
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        {
          "pattern": "\\.(wasm|json)(\\.gz)?$"
        }
      ]
    },
    "kind": {
      "enum": [
        "core",
        "component",
        "manifest"
      ]
    },
    "provider": {
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "repository": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+$"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "github"
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "gitlab"
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "manifest"
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "name": {
                "pattern": "\\.json(\\.gz)?$"
              }
            }
          },
          "asset": {
            "pattern": "\\.json(\\.gz)?$"
          }
        }
      },
      "else": {
        "properties": {
          "artifact": {
            "properties": {
              "name": {
                "pattern": "\\.wasm(\\.gz)?$"
              }
            }
          },
          "asset": {
            "pattern": "\\.wasm(\\.gz)?$"
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": [
        "asset",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "core",
            "component"
          ]
        },
        "schema_version": {
          "const": 1
        }
      },
      "not": {
        "required": [
          "artifact"
        ]
      }
    },
    {
      "required": [
        "artifact"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "asset"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ]
      }
    }
  ]
}
