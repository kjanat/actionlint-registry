{
  "$id": "https://plugins.actionlint.kjanat.dev/schemas/compatibility.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "host": {
      "type": "object",
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "interfaces": {
      "description": "Top-level component interface names, spelled as in the binary.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000\\r\\n]*$"
      }
    },
    "report": {
      "type": "object",
      "required": [
        "artifact_sha256",
        "checks",
        "host",
        "outcome",
        "policy",
        "schema_version"
      ],
      "dependentRequired": {
        "exports": [
          "imports"
        ],
        "imports": [
          "exports"
        ]
      },
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checks": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "detail": {
          "type": "string",
          "maxLength": 16384
        },
        "exports": {
          "$ref": "#/$defs/interfaces",
          "description": "The component's top-level exports whose kind is an instance."
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "imports": {
          "$ref": "#/$defs/interfaces",
          "description": "Every top-level import of the component."
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "unsupported"
          ]
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runner_as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "schema_version": {
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1
              },
              "detail": {
                "const": ""
              }
            }
          },
          "else": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "runner_as_of"
              ]
            }
          },
          "else": {
            "required": [
              "runner_as_of"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 3
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "imports"
              ]
            }
          }
        }
      ]
    }
  },
  "title": "Immutable host compatibility observation",
  "type": "object",
  "required": [
    "checker_sha256",
    "observed_at",
    "report"
  ],
  "properties": {
    "checker_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_sha256": {
      "description": "OCI root digest of the release whose platform layer the report checked.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report": {
      "$ref": "#/$defs/report"
    }
  },
  "additionalProperties": false
}
