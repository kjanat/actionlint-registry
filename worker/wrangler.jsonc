{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actionlint-plugin-registry",
  "account_id": "83a61abe8741defe835d035b1f4e49af",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": { "enabled": true }
  },
  "routes": [
    { "pattern": "registry.actionlint.kjanat.dev", "custom_domain": true }
  ],
  "vars": {
    "GITHUB_APP_INSTALLATION_ID": "172822417",
    "REGISTRY_ORIGIN": "https://registry.actionlint.kjanat.dev",
    "REGISTRY_REPOSITORY_ID": "1424600475",
    "REGISTRY_WORKFLOW_REF": "kjanat/actionlint-registry/.github/workflows/admission.yml@refs/heads/master"
  },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "PublicationInbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PublicationInbox"] }]
}
